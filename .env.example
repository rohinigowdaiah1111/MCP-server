# Copy this file to .env and fill in your Google OAuth client credentials.

# OAuth client credentials (Google Cloud Console > APIs & Services > Credentials > OAuth client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match a redirect URI registered on the OAuth client above.
# `npm run authorize` parses this to know which local host/port/path to listen on.
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Where the access/refresh token is stored, encrypted at rest (AES-256-GCM).
# Relative paths resolve from the project root.
GOOGLE_TOKEN_STORAGE_PATH=./tokens.json

# Name this server identifies itself with over MCP.
MCP_SERVER_NAME=google-workspace-mcp-server

# Minimum log level written to stderr: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Remote (HTTP) transport ---------------------------------------------------
# Only needed when hosting this server remotely (e.g. on Railway) instead of
# running it locally as a stdio child process spawned by Cursor. See
# deployment-plan.md. Leave unset for local/stdio usage — nothing below this
# section is read unless MCP_TRANSPORT=http.

# "stdio" (default, local Cursor usage) or "http" (remote hosting).
MCP_TRANSPORT=stdio

# Port the HTTP transport binds to. Railway sets this automatically — don't
# set it yourself on Railway. Only needed locally to smoke-test HTTP mode.
# PORT=8080

# Required when MCP_TRANSPORT=http: shared secret remote MCP clients must send
# as "Authorization: Bearer <token>" to /mcp (and "?token=<token>" to
# /authorize). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# MCP_AUTH_TOKEN=

# --- Optional ----------------------------------------------------------------

# Path to a service-account key file (Google Application Default Credentials).
# Not yet used by the auth flow (which always signs in as a single Google user
# via GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above) — reserved for a future
# service-account auth mode. See the NOTE in src/auth.ts.
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated allowlist of Google account emails permitted to use this
# server, e.g. "alice@example.com,bob@example.com". Not yet enforced — see
# the NOTE in src/auth.ts for what's needed to wire this up.
ALLOWED_GOOGLE_ACCOUNTS=

# Feature toggle: allow isHtml:true on gmail_create_draft/gmail_send_email.
ENABLE_HTML_EMAIL=true

# Feature toggle: register the docs_append_text tool at all.
ENABLE_DOCS_APPEND=true

# --- Additional hardening -----------------------------------------------------
# Kept from the previous .env layout (not part of the new required list) —
# remove this section if you don't need per-tool rate limiting, conflict
# retries, attachment size limits, or a pinned token-encryption key.

# Max tool calls allowed per tool, per rolling 60s window, before RATE_LIMITED.
# RATE_LIMIT_PER_MINUTE=60

# Max retry attempts when a Google Docs append hits a concurrent-edit conflict.
# MAX_CONFLICT_RETRIES=3

# Max attachment size (bytes) accepted by gmail tools. Default 20MB (Gmail's own limit).
# MAX_ATTACHMENT_BYTES=20971520

# Base64-encoded 32-byte key used to encrypt the token storage file at rest.
# If unset, a random key is generated on first run and stored in .token.key (git-ignored).
# TOKEN_ENCRYPTION_KEY=
