{
  "name": "gmail-docs-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that lets an AI agent draft/send Gmail emails and append content to Google Docs",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "bin": {
    "gmail-docs-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "authorize": "node dist/authorize.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "gmail",
    "google-docs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "10.5.0",
    "googleapis": "^173.0.0",
    "open": "^11.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
